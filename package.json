{
  "name": "pish-factor",
  "productName": "Aghrin PishFactor",
  "version": "1.0.1",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "Aghrin PishFactor — سامانه صدور پیش‌فاکتور شرکت آهن آگرین",
  "author": {
    "name": "شرکت آهن آگرین"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "desktop:start": "electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "arabic-persian-reshaper": "^1.0.1",
    "bidi-js": "^1.0.3",
    "electron-updater": "^6.8.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "lucide-react": "^0.511.0",
    "next": "^15.5.29",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "vazirmatn": "^33.0.3"
  }
}
