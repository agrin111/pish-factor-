# ---------------------------------------------------------------------------
# Aghrin PishFactor — نمونه فایل تنظیمات محیطی
# این فایل را با نام .env کپی کنید و مقادیر واقعی را وارد نمایید.
# هرگز فایل .env را در Git قرار ندهید.
# ---------------------------------------------------------------------------

# اتصال دیتابیس PostgreSQL
DATABASE_URL="postgresql://pishfactor:CHANGE_ME@localhost:5432/pishfactor?schema=public"

# کلید امضای Session — حداقل ۳۲ کاراکتر تصادفی. با دستور زیر بسازید:
#   openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_USE_A_RANDOM_64_CHAR_SECRET"

# عمر Session به ساعت (پیش‌فرض ۱۲ ساعت)
SESSION_TTL_HOURS="12"

# حساب مدیر اولیه که توسط prisma/seed.ts ساخته می‌شود
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Aghrin@1404"
SEED_ADMIN_NAME="مدیر سیستم"

# اطلاعات دیتابیس برای docker compose
POSTGRES_USER="pishfactor"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="pishfactor"

# آدرس عمومی سامانه (برای کوکی امن در محیط HTTPS)
APP_URL="http://localhost:3000"
